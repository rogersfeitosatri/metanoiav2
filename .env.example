# === Aplicação ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de dados: "demo" (dados semeados em memória/localStorage, sem serviços externos)
# ou "supabase" (usa as variáveis abaixo). O app roda em "demo" por padrão.
NEXT_PUBLIC_DATA_MODE=demo

# === Supabase (projeto "Meta") ===
# A URL e a chave publishable são seguras para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://ojrqbmayuimfzwlvxnei.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# A service role key é SECRETA — configure apenas nas variáveis de ambiente da Vercel,
# nunca no código nem em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# E-mails que devem virar administradores apos login/cadastro real no Supabase.
# Separar multiplos e-mails por virgula.
ADMIN_EMAILS=

# === Inteligência Artificial ===
# Provedor: "local" (motor determinístico, sem chave), "gemini", "openai" ou "anthropic".
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo. Se der erro 404, /api/ai/status?test=1 informa qual usar.
AI_MODEL=gemini-3.6-flash

# Alternativas
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_SAFETY_MODEL=gemini-3.6-flash

# === Jobs / segurança ===
CRON_SECRET=
ENCRYPTION_KEY=
