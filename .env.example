# === Aplicação ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de dados: "demo" (dados semeados em memória/localStorage, sem serviços externos)
# ou "supabase" (usa as variáveis abaixo). O app roda em "demo" por padrão.
NEXT_PUBLIC_DATA_MODE=demo

# === Supabase (necessário apenas em NEXT_PUBLIC_DATA_MODE=supabase) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Inteligência Artificial ===
# Provedor: "local" (motor de regras determinístico, sem chave), "anthropic" ou "openai".
# O app usa "local" por padrão, garantindo que os fluxos conversacionais funcionem sem chave.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_SAFETY_MODEL=claude-haiku-4-5-20251001

# === Jobs / segurança ===
CRON_SECRET=
ENCRYPTION_KEY=
