# === Aplicação ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de dados: "demo" (dados semeados em memória/localStorage, sem serviços externos)
# ou "supabase" (usa as variáveis abaixo). O app roda em "demo" por padrão.
NEXT_PUBLIC_DATA_MODE=demo

# === Supabase (projeto "Meta") ===
# A URL e a chave publishable são seguras para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://roaeetcygyfwvlaqbwyr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-iagQVZTbPGjMAIs6ISC5Q_f5dohDOq
# A service role key é SECRETA — configure apenas nas variáveis de ambiente da Vercel,
# nunca no código nem em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# === Inteligência Artificial ===
# Provedor: "local" (motor de regras determinístico, sem chave), "openai" ou "anthropic".
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_SAFETY_MODEL=gpt-4o-mini

# === Jobs / segurança ===
CRON_SECRET=
ENCRYPTION_KEY=
